# Private Control Link v1 client
# Same-host UDS profile (used by the Relay Compose overlay)
INCOMUDON_MANAGEMENT_PCL_TRANSPORT=uds
INCOMUDON_MANAGEMENT_PCL_UDS_SOCKET_PATH=/run/incomudon-pcl/relay.sock
INCOMUDON_MANAGEMENT_PCL_SERVICE_ID=management-main

# Cross-host mTLS TCP profile instead of the UDS variables above
# INCOMUDON_MANAGEMENT_PCL_TRANSPORT=mtls-tcp
# INCOMUDON_MANAGEMENT_PCL_RELAY_ADDRESS=relay:9443
# INCOMUDON_MANAGEMENT_PCL_SERVER_NAME=relay
# INCOMUDON_MANAGEMENT_PCL_CERT_FILE=/run/incomudon-management-pcl/client.crt
# INCOMUDON_MANAGEMENT_PCL_KEY_FILE=/run/incomudon-management-pcl/client.key
# INCOMUDON_MANAGEMENT_PCL_RELAY_CA_FILE=/run/incomudon-management-pcl/relay-ca.crt

INCOMUDON_MANAGEMENT_HTTP_LISTEN=:8080
