# Private Control Link v1 client
# Same-host UDS profile (used by the Relay Compose overlay)
INCOMUDON_MANAGEMENT_PCL_TRANSPORT=uds
INCOMUDON_MANAGEMENT_PCL_UDS_SOCKET_PATH=/run/incomudon-pcl/relay.sock
INCOMUDON_MANAGEMENT_PCL_SERVICE_ID=management-main

# Cross-host mTLS TCP profile instead of the UDS variables above
# INCOMUDON_MANAGEMENT_PCL_TRANSPORT=mtls-tcp
# INCOMUDON_MANAGEMENT_PCL_RELAY_ADDRESS=relay:9443
# INCOMUDON_MANAGEMENT_PCL_SERVER_NAME=relay
# INCOMUDON_MANAGEMENT_PCL_CERT_FILE=/run/incomudon-management-pcl/client.crt
# INCOMUDON_MANAGEMENT_PCL_KEY_FILE=/run/incomudon-management-pcl/client.key
# INCOMUDON_MANAGEMENT_PCL_RELAY_CA_FILE=/run/incomudon-management-pcl/relay-ca.crt

INCOMUDON_MANAGEMENT_HTTP_LISTEN=:8080

# Optional external Management API (TLS 1.3 mTLS). Empty leaves it disabled.
# INCOMUDON_MANAGEMENT_API_LISTEN=:8443
# INCOMUDON_MANAGEMENT_API_CERT_FILE=/run/secrets/management-api.crt
# INCOMUDON_MANAGEMENT_API_KEY_FILE=/run/secrets/management-api.key
# INCOMUDON_MANAGEMENT_API_CLIENT_CA_FILE=/run/secrets/management-api-client-ca.crt
# INCOMUDON_MANAGEMENT_API_SERVICES_FILE=/run/incomudon-management/management-services.csv
# INCOMUDON_MANAGEMENT_API_CHANNEL_ACL_FILE=/run/incomudon-management/management-channel-acl.csv
# INCOMUDON_MANAGEMENT_API_GLOBAL_PERMISSIONS_FILE=/run/incomudon-management/management-global-permissions.csv
# INCOMUDON_MANAGEMENT_API_EVENT_DELIVERY=live

# Enable Service Admission grant issuance only when all signing settings are set.
# Mount the private key read-only.
# INCOMUDON_MANAGEMENT_GRANT_SIGNING_KEY_FILE=/run/secrets/service-admission-ed25519.key
# INCOMUDON_MANAGEMENT_GRANT_KEY_ID=service-admission-2026-01
# INCOMUDON_MANAGEMENT_GRANT_ISSUER=incomudon-management
# INCOMUDON_MANAGEMENT_GRANT_AUDIENCE=incomudon-relay
# INCOMUDON_MANAGEMENT_GRANT_TTL_SECONDS=300
